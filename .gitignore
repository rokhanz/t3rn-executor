# === 🔐 SENSITIVE CONFIGURATION FILES ===
# Never commit these files - they contain secrets
.env
.env.local
.env.production
.env.staging
.env.development
.env.test
*.env
.env.*

# Private keys and wallets
*.key
*.pem
*.p12
*.pfx
private_key*
wallet*
keystore/
keys/

# API keys and tokens
api_keys.txt
tokens.txt
secrets.txt
credentials.txt

