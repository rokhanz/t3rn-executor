!LICENSE
!.env.example

# === 📋 WHITELIST IMPORTANT FILES ===
# Force include important files even if they match patterns above
!config/network_code_map.conf
!config/network_mappings.conf
!modules/*.sh
!anti_mev/*.js
!autorun.sh
!main.sh
